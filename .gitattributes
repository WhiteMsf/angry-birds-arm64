# Keep repository text files normalized to LF.
* text=auto

*.c      text eol=lf
*.cpp    text eol=lf
*.h      text eol=lf
*.hpp    text eol=lf
*.py     text eol=lf
*.sh     text eol=lf
*.cmake  text eol=lf
CMakeLists.txt text eol=lf

*.md     text eol=lf
*.txt    text eol=lf
*.json   text eol=lf
*.xml    text eol=lf

# Windows-native launchers may use CRLF in the working tree.
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Binary files.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.gz     binary
*.apk    binary
*.so     binary
